# ============================================
# CONFIGURAÇÕES DO PROJETO TIKTOK APOSTAS
# ============================================
# Copie este arquivo para .env e preencha com suas chaves

# --- The Odds API (gratuito: 500 req/mês) ---
# Cadastro: https://the-odds-api.com/
ODDS_API_KEY=sua_chave_aqui

# --- API Football (gratuito: 100 req/dia) ---
# Cadastro: https://www.api-football.com/
API_FOOTBALL_KEY=sua_chave_aqui

# --- Google Drive (para salvar os vídeos) ---
# Instruções de configuração em: docs/google_drive_setup.md
GOOGLE_DRIVE_FOLDER_ID=id_da_pasta_aqui

# --- Configurações do Canal ---
CANAL_NOME=Sorte do Dia
CANAL_USUARIO=@sortedodia01

# --- Configurações de Vídeo ---
VIDEO_LARGURA=1080
VIDEO_ALTURA=1920
VIDEO_FPS=30
VIDEO_DURACAO=40
