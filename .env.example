# ============================================
# CONFIGURAÇÕES DO PROJETO — SORTE DO DIA
# ============================================
# Copie este arquivo para .env e preencha com suas chaves

# --- Supabase (obrigatório — é a fonte de verdade de config/histórico) ---
# Painel: https://supabase.com/dashboard/project/zfyttnfmpvuzntmtqgyk
SUPABASE_URL=https://zfyttnfmpvuzntmtqgyk.supabase.co
SUPABASE_KEY=chave_publishable_do_supabase_aqui

# --- The Odds API (opcional — sem ela, o bot busca jogos direto na Superbet) ---
# Cadastro: https://the-odds-api.com/
ODDS_API_KEY=

# --- API Football (não usada atualmente) ---
API_FOOTBALL_KEY=

# --- Google Drive (upload de vídeo — atualmente desativado no main.py) ---
GOOGLE_DRIVE_FOLDER_ID=

# --- Configurações do Canal ---
CANAL_NOME=Sorte do Dia
CANAL_USUARIO=@sortedodia01

# --- Configurações de Vídeo ---
VIDEO_LARGURA=1080
VIDEO_ALTURA=1920
VIDEO_FPS=30
VIDEO_DURACAO=40
